{
  "title": ".NET REST API Production Observability",
  "uid": "net-perform-pro-v4",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      { "name": "service", "label": "Service", "type": "query", "datasource": { "type": "prometheus", "uid": "Prometheus" }, "query": "label_values(restapi_http_request_count_total, service_name)", "refresh": 2, "includeAll": true, "multi": true, "allValue": ".*", "current": { "text": "All", "value": ["$__all"] } },
      { "name": "instance", "label": "Instance", "type": "query", "datasource": { "type": "prometheus", "uid": "Prometheus" }, "query": "label_values(restapi_http_request_count_total{service_name=~\"$service\"}, instance)", "refresh": 2, "includeAll": true, "multi": true, "allValue": ".*", "current": { "text": "All", "value": ["$__all"] } },
      { "name": "method", "label": "HTTP method", "type": "query", "datasource": { "type": "prometheus", "uid": "Prometheus" }, "query": "label_values(restapi_http_request_count_total{service_name=~\"$service\"}, http_request_method)", "refresh": 2, "includeAll": true, "multi": true, "allValue": ".*", "current": { "text": "All", "value": ["$__all"] } },
      { "name": "status", "label": "Status code", "type": "query", "datasource": { "type": "prometheus", "uid": "Prometheus" }, "query": "label_values(restapi_http_request_count_total{service_name=~\"$service\"}, http_response_status_code)", "refresh": 2, "includeAll": true, "multi": true, "allValue": ".*", "current": { "text": "All", "value": ["$__all"] } },
      { "name": "database", "label": "PostgreSQL database", "type": "query", "datasource": { "type": "prometheus", "uid": "Prometheus" }, "query": "label_values(pg_stat_database_numbackends, datname)", "refresh": 2, "includeAll": true, "multi": true, "allValue": ".*", "current": { "text": "neominal_demo", "value": ["neominal_demo"] } }
    ]
  },
  "annotations": { "list": [] },
  "panels": [
    { "id": 1, "type": "row", "title": "API Overview", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 } },
    { "id": 2, "type": "stat", "title": "REST API availability", "description": "Prometheus scrape health for the API target.", "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "max(up{job=\"rest-api\"})", "legendFormat": "API" } ], "fieldConfig": { "defaults": { "unit": "short", "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } } },
    { "id": 3, "type": "stat", "title": "Request rate", "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum(rate(restapi_http_request_count_total{service_name=~\"$service\",instance=~\"$instance\",http_request_method=~\"$method\",http_response_status_code=~\"$status\"}[5m]))", "legendFormat": "req/s" } ], "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } } },
    { "id": 4, "type": "stat", "title": "5xx error rate", "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "100 * sum(rate(restapi_http_request_count_total{service_name=~\"$service\",http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(restapi_http_request_count_total{service_name=~\"$service\"}[5m])), 0.001)" } ], "fieldConfig": { "defaults": { "unit": "percent", "decimals": 2, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } } } },
    { "id": 5, "type": "stat", "title": "Active requests", "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum(restapi_http_active_requests{service_name=~\"$service\"})" } ], "fieldConfig": { "defaults": { "unit": "short" } } },
    { "id": 6, "type": "stat", "title": "PostgreSQL up", "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "max(pg_up)" } ], "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } } },
    { "id": 7, "type": "stat", "title": "Collector scrape up", "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "max(up{job=\"otel-collector\"})" } ], "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] } } },
    { "id": 8, "type": "timeseries", "title": "Request rate by method", "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum by (http_request_method) (rate(restapi_http_request_count_total{service_name=~\"$service\",instance=~\"$instance\",http_request_method=~\"$method\",http_response_status_code=~\"$status\"}[5m]))", "legendFormat": "{{http_request_method}}" } ], "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } } },
    { "id": 9, "type": "timeseries", "title": "Request latency p50 / p95 / p99", "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(restapi_http_request_duration_seconds_bucket{service_name=~\"$service\",instance=~\"$instance\",http_request_method=~\"$method\"}[5m])))", "legendFormat": "p50" }, { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(restapi_http_request_duration_seconds_bucket{service_name=~\"$service\",instance=~\"$instance\",http_request_method=~\"$method\"}[5m])))", "legendFormat": "p95" }, { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(restapi_http_request_duration_seconds_bucket{service_name=~\"$service\",instance=~\"$instance\",http_request_method=~\"$method\"}[5m])))", "legendFormat": "p99" } ], "fieldConfig": { "defaults": { "unit": "s", "min": 0 } } },
    { "id": 10, "type": "timeseries", "title": "HTTP status distribution", "gridPos": { "x": 0, "y": 13, "w": 8, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum by (http_response_status_code) (rate(restapi_http_request_count_total{service_name=~\"$service\",http_response_status_code=~\"$status\"}[5m]))", "legendFormat": "{{http_response_status_code}}" } ], "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "id": 11, "type": "timeseries", "title": "HTTP 4xx / 5xx rate", "gridPos": { "x": 8, "y": 13, "w": 8, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum by (http_response_status_code) (rate(restapi_http_request_count_total{service_name=~\"$service\",http_response_status_code=~\"4..\"}[5m]))", "legendFormat": "4xx" }, { "refId": "B", "expr": "sum by (http_response_status_code) (rate(restapi_http_request_count_total{service_name=~\"$service\",http_response_status_code=~\"5..\"}[5m]))", "legendFormat": "5xx" } ], "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "id": 12, "type": "table", "title": "Top routes by traffic", "gridPos": { "x": 16, "y": 13, "w": 8, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "topk(10, sum by (http_route) (rate(restapi_http_request_count_total{service_name=~\"$service\"}[5m])))", "format": "table", "instant": true, "legendFormat": "{{http_route}}" } ], "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "id": 13, "type": "timeseries", "title": "Active requests", "gridPos": { "x": 0, "y": 21, "w": 8, "h": 7 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum(restapi_http_active_requests{service_name=~\"$service\"})", "legendFormat": "active" } ] },
    { "id": 14, "type": "timeseries", "title": "ASP.NET authentication / authorization", "gridPos": { "x": 8, "y": 21, "w": 8, "h": 7 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "rate(aspnetcore_authentication_authenticate_duration_seconds_count{service_name=~\"$service\"}[5m])", "legendFormat": "authentication" }, { "refId": "B", "expr": "rate(aspnetcore_authorization_attempts_total{service_name=~\"$service\"}[5m])", "legendFormat": "authorization attempts" } ], "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "id": 15, "type": "timeseries", "title": "HTTP server instrumentation", "gridPos": { "x": 16, "y": 21, "w": 8, "h": 7 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum by (http_request_method) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\",http_request_method=~\"$method\"}[5m]))", "legendFormat": "{{http_request_method}}" } ], "fieldConfig": { "defaults": { "unit": "reqps" } } },
    { "id": 16, "type": "row", "title": ".NET Runtime, GC, memory and process", "gridPos": { "x": 0, "y": 28, "w": 24, "h": 1 } },
    { "id": 17, "type": "timeseries", "title": "Process CPU", "gridPos": { "x": 0, "y": 29, "w": 8, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum by (cpu_mode) (rate(dotnet_process_cpu_time_seconds_total{service_name=~\"$service\"}[5m]))", "legendFormat": "{{cpu_mode}}" } ], "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 } } },
    { "id": 18, "type": "timeseries", "title": "Working set memory", "gridPos": { "x": 8, "y": 29, "w": 8, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "dotnet_process_memory_working_set_bytes{service_name=~\"$service\"}", "legendFormat": "{{service_name}}" } ], "fieldConfig": { "defaults": { "unit": "bytes" } } },
    { "id": 19, "type": "timeseries", "title": "GC heap by generation", "gridPos": { "x": 16, "y": 29, "w": 8, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "dotnet_gc_last_collection_heap_size_bytes{service_name=~\"$service\"}", "legendFormat": "{{gc_heap_generation}}" } ], "fieldConfig": { "defaults": { "unit": "bytes" } } },
    { "id": 20, "type": "timeseries", "title": "GC pause and collections", "gridPos": { "x": 0, "y": 37, "w": 8, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "rate(dotnet_gc_pause_time_seconds_total{service_name=~\"$service\"}[5m])", "legendFormat": "pause" }, { "refId": "B", "expr": "rate(dotnet_gc_collections_total{service_name=~\"$service\"}[5m])", "legendFormat": "collections {{gc_collection_generation}}" } ], "fieldConfig": { "defaults": { "unit": "short" } } },
    { "id": 21, "type": "timeseries", "title": "Thread pool", "gridPos": { "x": 8, "y": 37, "w": 8, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "dotnet_thread_pool_thread_count_total{service_name=~\"$service\"}", "legendFormat": "threads" }, { "refId": "B", "expr": "dotnet_thread_pool_queue_length_total{service_name=~\"$service\"}", "legendFormat": "queue" }, { "refId": "C", "expr": "dotnet_thread_pool_work_item_count_total{service_name=~\"$service\"}", "legendFormat": "work items" } ] },
    { "id": 22, "type": "timeseries", "title": "Exceptions by type", "gridPos": { "x": 16, "y": 37, "w": 8, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum by (error_type) (rate(dotnet_exceptions_total{service_name=~\"$service\"}[5m]))", "legendFormat": "{{error_type}}" } ], "fieldConfig": { "defaults": { "unit": "ops" } } },
    { "id": 23, "type": "timeseries", "title": "JIT and monitor contention", "gridPos": { "x": 0, "y": 45, "w": 8, "h": 7 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "rate(dotnet_jit_compilation_time_seconds_total{service_name=~\"$service\"}[5m])", "legendFormat": "JIT seconds" }, { "refId": "B", "expr": "rate(dotnet_monitor_lock_contentions_total{service_name=~\"$service\"}[5m])", "legendFormat": "lock contentions" } ] },
    { "id": 24, "type": "timeseries", "title": "Timers and assemblies", "gridPos": { "x": 8, "y": 45, "w": 8, "h": 7 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "dotnet_timer_count{service_name=~\"$service\"}", "legendFormat": "timers" }, { "refId": "B", "expr": "dotnet_assembly_count{service_name=~\"$service\"}", "legendFormat": "assemblies" } ] },
    { "id": 25, "type": "timeseries", "title": "Process resources", "gridPos": { "x": 16, "y": 45, "w": 8, "h": 7 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "process_thread_count{job=\"rest-api\"}", "legendFormat": "threads" }, { "refId": "B", "expr": "process_resident_memory_bytes{job=\"rest-api\"}", "legendFormat": "resident memory" } ], "fieldConfig": { "defaults": { "unit": "short" } } },
    { "id": 26, "type": "row", "title": "PostgreSQL", "gridPos": { "x": 0, "y": 52, "w": 24, "h": 1 } },
    { "id": 27, "type": "stat", "title": "PostgreSQL exporter", "gridPos": { "x": 0, "y": 53, "w": 4, "h": 4 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "max(pg_up)" } ], "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } } ] } } },
    { "id": 28, "type": "timeseries", "title": "Database connections", "gridPos": { "x": 4, "y": 53, "w": 7, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "pg_stat_database_numbackends{datname=~\"$database\"}", "legendFormat": "{{datname}}" } ] },
    { "id": 29, "type": "timeseries", "title": "Transactions", "gridPos": { "x": 11, "y": 53, "w": 7, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "rate(pg_stat_database_xact_commit{datname=~\"$database\"}[5m])", "legendFormat": "commit" }, { "refId": "B", "expr": "rate(pg_stat_database_xact_rollback{datname=~\"$database\"}[5m])", "legendFormat": "rollback" } ], "fieldConfig": { "defaults": { "unit": "ops" } } },
    { "id": 30, "type": "timeseries", "title": "Database size and locks", "gridPos": { "x": 18, "y": 53, "w": 6, "h": 8 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "pg_database_size_bytes{datname=~\"$database\"}", "legendFormat": "size" }, { "refId": "B", "expr": "pg_locks_count", "legendFormat": "locks" } ], "fieldConfig": { "defaults": { "unit": "bytes" } } },
    { "id": 31, "type": "timeseries", "title": "PostgreSQL exporter health", "gridPos": { "x": 0, "y": 61, "w": 12, "h": 7 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "pg_scrape_collector_success", "legendFormat": "{{collector}}" }, { "refId": "B", "expr": "rate(pg_exporter_scrapes_total[5m])", "legendFormat": "scrapes" }, { "refId": "C", "expr": "pg_exporter_last_scrape_error", "legendFormat": "last error" } ] },
    { "id": 32, "type": "timeseries", "title": "Prometheus targets", "gridPos": { "x": 12, "y": 61, "w": 12, "h": 7 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "up", "legendFormat": "{{job}} / {{instance}}" } ] },
    { "id": 33, "type": "row", "title": "Tracing and OTel signal health", "gridPos": { "x": 0, "y": 68, "w": 24, "h": 1 } },
    { "id": 34, "type": "traces", "title": "Recent REST API traces", "gridPos": { "x": 0, "y": 69, "w": 16, "h": 10 }, "datasource": { "type": "jaeger", "uid": "Jaeger" }, "targets": [ { "refId": "A", "queryType": "search", "service": "rest-api", "operation": "", "limit": 50 } ] },
    { "id": 35, "type": "timeseries", "title": "API OTel metric throughput", "gridPos": { "x": 16, "y": 69, "w": 8, "h": 10 }, "datasource": { "type": "prometheus", "uid": "Prometheus" }, "targets": [ { "refId": "A", "expr": "sum(rate(restapi_http_request_count_total{service_name=~\"$service\"}[5m]))", "legendFormat": "API metrics" }, { "refId": "B", "expr": "sum(rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[5m]))", "legendFormat": "ASP.NET metrics" } ], "fieldConfig": { "defaults": { "unit": "reqps" } } }
  ],
  "links": []
}
